<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Giỏ Hàng & Đơn Hàng</title>
    <link rel="stylesheet" href="/client/css/style.css" />
    <link rel="stylesheet" href="/client/css/product.css" />
    <link
      rel="stylesheet"
      href="https://cdn.jsdelivr.net/npm/bootstrap@4.3.1/dist/css/bootstrap.min.css"
      integrity="sha384-ggOyR0iXCbMQv3Xipma34MD+dH/1fQ784/j6cY/iJTQUOhcWr7x9JvoRxT2MZw1T"
      crossorigin="anonymous"
    />
    <link href="https://fonts.googleapis.com/css2?family=Montserrat:wght@400;500;600;700;800&family=Poppins:wght@400;500;600;700&display=swap" rel="stylesheet">
    <style>
      :root {
        --primary: #111;
        --secondary: #f5f5f5;
        --accent: #ff3b30;
        --text: #111;
        --text-light: #666;
        --border: #e5e5e5;
        --shadow: 0 4px 20px rgba(0, 0, 0, 0.08);
        --shadow-hover: 0 8px 30px rgba(0, 0, 0, 0.12);
        --transition: all 0.3s cubic-bezier(0.4, 0, 0.2, 1);
        --gradient: linear-gradient(135deg, #f8f9fa 0%, #ffffff 100%);
        --gradient-dark: linear-gradient(45deg, #111 30%, #333 90%);
        --gradient-accent: linear-gradient(45deg, #ff3b30 0%, #ff2d55 100%);
      }

      body {
        background-color: #ffffff;
        font-family: 'Poppins', sans-serif;
        color: var(--text);
        min-height: 100vh;
        display: flex;
        flex-direction: column;
      }

      .container-news {
        background-color: #ffffff;
        padding: 100px 0;
        margin-bottom: 0;
        flex: 1;
        position: relative;
        overflow: hidden;
        max-width: 1200px;
        margin: 0 auto;
        padding-left: 20px;
        padding-right: 20px;
      }

      .container-news::before {
        content: '';
        position: absolute;
        top: 0;
        left: 0;
        right: 0;
        height: 500px;
        background: var(--gradient);
        z-index: 0;
        transform: skewY(-3deg);
        transform-origin: top left;
      }

      .page-header {
        text-align: center;
        margin-bottom: 80px;
        position: relative;
        z-index: 1;
      }

      .page-header h1 {
        font-family: 'Montserrat', sans-serif;
        font-size: 4rem;
        font-weight: 800;
        color: var(--text);
        letter-spacing: -2px;
        margin: 0;
        text-transform: uppercase;
        background: var(--gradient-dark);
        -webkit-background-clip: text;
        -webkit-text-fill-color: transparent;
        position: relative;
        animation: fadeInUp 1s ease;
      }

      .page-header h1::after {
        content: '';
        position: absolute;
        bottom: -20px;
        left: 50%;
        transform: translateX(-50%);
        width: 100px;
        height: 4px;
        background: var(--gradient-dark);
        border-radius: 2px;
        animation: widthGrow 1.5s ease;
      }

      .switch-buttons {
        display: flex;
        justify-content: center;
        margin-bottom: 80px;
        gap: 40px;
        position: relative;
        z-index: 1;
      }

      .switch-buttons button {
        width: 280px;
        padding: 18px 36px;
        font-family: 'Montserrat', sans-serif;
        font-size: 0.95rem;
        font-weight: 600;
        border-radius: 50px;
        border: none;
        transition: var(--transition);
        text-transform: uppercase;
        letter-spacing: 2px;
        position: relative;
        overflow: hidden;
        animation: fadeInUp 1s ease 0.2s backwards;
      }

      .switch-buttons .btn-primary {
        background: var(--gradient-dark);
        color: white;
      }

      .switch-buttons .btn-secondary {
        background: var(--secondary);
        color: var(--text);
        border: 2px solid var(--border);
      }

      .switch-buttons button::before {
        content: '';
        position: absolute;
        top: 0;
        left: 0;
        width: 100%;
        height: 100%;
        background: linear-gradient(45deg, rgba(255,255,255,0.1) 0%, rgba(255,255,255,0) 100%);
        transition: var(--transition);
      }

      .switch-buttons button:hover {
        transform: translateY(-5px);
        box-shadow: var(--shadow-hover);
      }

      .switch-buttons button:hover::before {
        opacity: 0;
      }

      .section {
        background-color: #fff;
        border-radius: 30px;
        box-shadow: var(--shadow);
        overflow: hidden;
        position: relative;
        z-index: 1;
        transition: var(--transition);
        border: 1px solid rgba(0,0,0,0.05);
        animation: fadeInUp 1s ease 0.4s backwards;
      }

      .section:hover {
        transform: translateY(-8px);
        box-shadow: var(--shadow-hover);
      }

      .table {
        margin-bottom: 0;
      }

      .table thead th {
        background-color: #f8f9fa;
        color: var(--text);
        font-family: 'Montserrat', sans-serif;
        font-weight: 600;
        font-size: 0.85rem;
        text-transform: uppercase;
        letter-spacing: 2px;
        padding: 28px 24px;
        border: none;
        position: relative;
      }

      .table thead th::after {
        content: '';
        position: absolute;
        bottom: 0;
        left: 24px;
        right: 24px;
        height: 1px;
        background: var(--border);
      }

      .table tbody td {
        padding: 32px 24px;
        vertical-align: middle;
        border-bottom: 1px solid var(--border);
        font-size: 0.95rem;
        transition: var(--transition);
      }

      .table tbody tr:hover td {
        background-color: #f8f9fa;
        transform: scale(1.01);
      }

      .table tbody tr:last-child td {
        border-bottom: none;
      }

      .product-link {
        color: var(--text);
        font-weight: 500;
        text-decoration: none;
        transition: var(--transition);
        display: inline-block;
        position: relative;
      }

      .product-link::after {
        content: '';
        position: absolute;
        bottom: -2px;
        left: 0;
        width: 0;
        height: 2px;
        background: var(--text);
        transition: var(--transition);
      }

      .product-link:hover {
        color: var(--text);
        text-decoration: none;
      }

      .product-link:hover::after {
        width: 100%;
      }

      .btn-danger {
        background: var(--gradient-accent);
        border: none;
        padding: 12px 28px;
        font-family: 'Montserrat', sans-serif;
        font-size: 0.85rem;
        font-weight: 600;
        border-radius: 25px;
        transition: var(--transition);
        text-transform: uppercase;
        letter-spacing: 1.5px;
        color: white;
      }

      .btn-danger:hover {
        transform: translateY(-3px);
        box-shadow: 0 4px 12px rgba(255, 59, 48, 0.3);
        color: white;
      }

      .btn-primary {
        background: var(--gradient-dark);
        border: none;
        padding: 18px 36px;
        font-family: 'Montserrat', sans-serif;
        font-size: 0.95rem;
        font-weight: 600;
        border-radius: 30px;
        transition: var(--transition);
        text-transform: uppercase;
        letter-spacing: 2px;
        color: white;
      }

      .btn-primary:hover {
        transform: translateY(-3px);
        box-shadow: var(--shadow-hover);
        color: white;
      }

      .btn-secondary {
        background: var(--secondary);
        border: 2px solid var(--border);
        color: var(--text);
        padding: 18px 36px;
        font-family: 'Montserrat', sans-serif;
        font-size: 0.95rem;
        font-weight: 600;
        border-radius: 30px;
        transition: var(--transition);
        text-transform: uppercase;
        letter-spacing: 2px;
      }

      .btn-secondary:hover {
        background-color: #e5e5e5;
        transform: translateY(-3px);
        box-shadow: var(--shadow);
        color: var(--text);
      }

      .total-amount {
        font-family: 'Montserrat', sans-serif;
        font-size: 2.25rem;
        font-weight: 700;
        color: var(--text);
        margin-bottom: 36px;
        display: flex;
        align-items: center;
        gap: 20px;
      }

      .total-amount::before {
        content: '';
        display: block;
        width: 60px;
        height: 3px;
        background: var(--gradient-dark);
        border-radius: 2px;
      }

      .footer-button {
        text-align: right;
      }

      .hidden {
        display: none;
      }

      .status-badge {
        padding: 12px 24px;
        border-radius: 25px;
        font-family: 'Montserrat', sans-serif;
        font-size: 0.85rem;
        font-weight: 600;
        text-transform: uppercase;
        letter-spacing: 1.5px;
        display: inline-flex;
        align-items: center;
        gap: 10px;
      }

      .status-badge::before {
        content: '';
        display: block;
        width: 10px;
        height: 10px;
        border-radius: 50%;
        background: currentColor;
      }

      .status-pending {
        background-color: #fff3cd;
        color: #856404;
      }

      .status-completed {
        background-color: #d4edda;
        color: #155724;
      }

      .status-cancelled {
        background-color: #f8d7da;
        color: #721c24;
      }

      @keyframes fadeInUp {
        from {
          opacity: 0;
          transform: translateY(20px);
        }
        to {
          opacity: 1;
          transform: translateY(0);
        }
      }

      @keyframes widthGrow {
        from {
          width: 0;
        }
        to {
          width: 100px;
        }
      }

      @media (max-width: 1200px) {
        .container-news {
          max-width: 960px;
        }
      }

      @media (max-width: 992px) {
        .container-news {
          max-width: 720px;
        }

        .page-header h1 {
          font-size: 3.25rem;
        }

        .switch-buttons button {
          width: 240px;
          padding: 16px 32px;
        }
      }

      @media (max-width: 768px) {
        .container-news {
          max-width: 540px;
          padding: 60px 15px;
        }

        .page-header h1 {
          font-size: 2.75rem;
        }

        .switch-buttons {
          flex-direction: column;
          align-items: center;
          gap: 20px;
        }

        .switch-buttons button {
          width: 100%;
          max-width: 300px;
        }

        .table thead {
          display: none;
        }

        .table tbody td {
          display: block;
          text-align: right;
          padding: 20px;
          position: relative;
          padding-left: 50%;
        }

        .table tbody td:before {
          content: attr(data-label);
          position: absolute;
          left: 20px;
          width: 45%;
          font-weight: 600;
          text-align: left;
        }

        .footer-button {
          text-align: center;
          margin-top: 36px;
        }

        .total-amount {
          justify-content: center;
          font-size: 2rem;
        }

        .btn-danger, .btn-primary, .btn-secondary {
          width: 100%;
          text-align: center;
        }
      }

      @media (max-width: 576px) {
        .container-news {
          padding: 40px 15px;
        }

        .page-header h1 {
          font-size: 2.25rem;
        }

        .total-amount {
          font-size: 1.75rem;
        }

        .section {
          border-radius: 20px;
        }

        .table tbody td {
          padding: 15px;
          font-size: 0.9rem;
        }

        .product-image {
          width: 80px;
          height: 80px;
        }
      }
    </style>
  </head>
  <body>
    <!-- Include header.ejs -->
    <%- include('../../partials/header.ejs') %>

    <div class="container-news">
      <div class="page-header">
        <h1>Giỏ Hàng & Đơn Hàng</h1>
      </div>

      <div class="switch-buttons">
        <button id="cartBtn" class="btn btn-primary">Giỏ Hàng</button>
        <button id="ordersBtn" class="btn btn-secondary">Đơn Hàng Đã Đặt</button>
      </div>

      <!-- Giỏ Hàng -->
      <div id="cartSection" class="section">
        <div class="table-responsive">
          <table class="table">
            <thead>
              <tr>
                <th scope="col">STT</th>
                <th scope="col">Tên Sản Phẩm</th>
                <th scope="col">Giá</th>
                <th scope="col">Số Lượng</th>
                <th scope="col">Tổng</th>
                <th scope="col">Hành Động</th>
              </tr>
            </thead>
            <tbody>
              <% cartProduct.forEach((item,index)=>{ %>
              <tr>
                <td data-label="STT"><%=index+1%></td>
                <td data-label="Tên Sản Phẩm">
                  <a href="/product/detail/<%=item.productInfo.slugProduct%>" class="product-link">
                    <%=item.productInfo.title%>
                  </a>
                </td>
                <td data-label="Giá"><%=item.productInfo.price.toLocaleString()%> VND</td>
                <td data-label="Số Lượng"><%=item.quantity%></td>
                <td data-label="Tổng"><%=item.priceTotal%> VND</td>
                <td data-label="Hành Động">
                  <button class="btn btn-danger">Xóa</button>
                </td>
              </tr>
              <%}) %>
            </tbody>
          </table>
        </div>

        <div class="row p-4">
          <div class="col-md-6">
            <a href="/" class="btn btn-secondary">Tiếp tục mua sắm</a>
          </div>
          <div class="col-md-6 footer-button">
            <div class="total-amount">
              Tổng Tiền: <span id="totalAmount"><%= cartProduct.totalPrice%> VND</span>
            </div>
            <a href="/order/checkout" class="btn btn-primary">Thanh Toán</a>
          </div>
        </div>
      </div>

      <!-- Đơn Hàng Đã Đặt -->
      <div id="ordersSection" class="section hidden">
        <div class="table-responsive">
          <table class="table">
            <thead>
              <tr>
                <th scope="col">STT</th>
                <th scope="col">Mã Đơn Hàng</th>
                <th scope="col">Ngày Đặt</th>
                <th scope="col">Tổng Tiền</th>
                <th scope="col">Trạng Thái</th>
                <th scope="col">Hành Động</th>
              </tr>
            </thead>
            <tbody>
              <% orders.forEach((order, index) => { %>
              <tr>
                <td data-label="STT"><%= index + 1 %></td>
                <td data-label="Mã Đơn Hàng"><%= order.orderId %></td>
                <td data-label="Ngày Đặt"><%= new Date(order.createdAt).toLocaleString('vi-VN') %></td>
                <td data-label="Tổng Tiền"><%= order.totalPriceAll.toLocaleString('vi-VN') %> VND</td>
                <td data-label="Trạng Thái">
                  <span class="status-badge status-<%= order.status.toLowerCase() %>">
                    <%= order.status %>
                  </span>
                </td>
                <td data-label="Hành Động">
                  <a href="/order/order-detail/<%= order.orderId %>" class="btn btn-primary btn-sm">
                    Xem Chi Tiết
                  </a>
                </td>
              </tr>
              <% }) %>
            </tbody>
          </table>
        </div>
      </div>
    </div>

    <!-- Include footer.ejs -->
    <%- include('../../partials/footer.ejs') %>

    <!-- Scripts -->
    <script src="https://code.jquery.com/jquery-3.3.1.slim.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/popper.js@1.14.7/dist/umd/popper.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@4.3.1/dist/js/bootstrap.min.js"></script>
    <script>
      const cartBtn = document.getElementById("cartBtn");
      const ordersBtn = document.getElementById("ordersBtn");
      const cartSection = document.getElementById("cartSection");
      const ordersSection = document.getElementById("ordersSection");

      cartBtn.addEventListener("click", () => {
        cartSection.classList.remove("hidden");
        ordersSection.classList.add("hidden");
        cartBtn.classList.add("btn-primary");
        cartBtn.classList.remove("btn-secondary");
        ordersBtn.classList.add("btn-secondary");
        ordersBtn.classList.remove("btn-primary");
      });

      ordersBtn.addEventListener("click", () => {
        ordersSection.classList.remove("hidden");
        cartSection.classList.add("hidden");
        ordersBtn.classList.add("btn-primary");
        ordersBtn.classList.remove("btn-secondary");
        cartBtn.classList.add("btn-secondary");
        cartBtn.classList.remove("btn-primary");
      });
    </script>
  </body>
</html>
