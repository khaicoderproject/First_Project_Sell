<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Digital Marketplace - Dashboard</title>
    
    <!-- Bootstrap CSS -->
    <link rel="stylesheet" href="https://stackpath.bootstrapcdn.com/bootstrap/4.5.2/css/bootstrap.min.css">
    <!-- Font Awesome -->
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/5.15.4/css/all.min.css">
    <!-- Google Fonts -->
    <link href="https://fonts.googleapis.com/css2?family=Poppins:wght@300;400;500;600;700&display=swap" rel="stylesheet">
    <!-- AOS Animation -->
    <link href="https://unpkg.com/aos@2.3.1/dist/aos.css" rel="stylesheet">
    
    <style>
        body {
            font-family: 'Poppins', sans-serif;
            background-color: #f8f9fa;
        }
        .hero-section {
            background: linear-gradient(135deg, #1a1a1a 0%, #4a4a4a 100%);
            color: white;
            padding: 80px 0;
            position: relative;
            overflow: hidden;
        }
        .hero-section::before {
            content: '';
            position: absolute;
            top: 0;
            left: 0;
            right: 0;
            bottom: 0;
            background: url('https://images.unsplash.com/photo-1607082348824-0a96f2a4b9da?ixlib=rb-1.2.1&auto=format&fit=crop&w=1950&q=80') center/cover;
            opacity: 0.1;
        }
        .product-card {
            background: white;
            border-radius: 15px;
            overflow: hidden;
            transition: transform 0.3s ease, box-shadow 0.3s ease;
            box-shadow: 0 4px 6px rgba(0, 0, 0, 0.1);
            height: 100%;
        }
        .product-card:hover {
            transform: translateY(-5px);
            box-shadow: 0 8px 15px rgba(0, 0, 0, 0.1);
        }
        .product-image {
            height: 250px;
            object-fit: cover;
            width: 100%;
        }
        .category-badge {
            position: absolute;
            top: 10px;
            right: 10px;
            background: rgba(0, 0, 0, 0.7);
            color: white;
            padding: 5px 15px;
            border-radius: 20px;
            font-size: 0.8rem;
            z-index: 1;
        }
        .price-tag {
            background: #1a1a1a;
            color: white;
            padding: 8px 15px;
            border-radius: 20px;
            font-weight: 600;
            font-size: 0.9rem;
        }
        .feature-card {
            background: white;
            border-radius: 15px;
            padding: 30px;
            text-align: center;
            transition: all 0.3s ease;
            box-shadow: 0 4px 6px rgba(0, 0, 0, 0.1);
        }
        .feature-card:hover {
            transform: translateY(-5px);
            box-shadow: 0 8px 15px rgba(0, 0, 0, 0.1);
        }
        .feature-icon {
            width: 60px;
            height: 60px;
            background: #f8f9fa;
            border-radius: 50%;
            display: flex;
            align-items: center;
            justify-content: center;
            margin: 0 auto 20px;
        }
        .collection-section {
            background: linear-gradient(135deg, #f8f9fa 0%, #e9ecef 100%);
            padding: 80px 0;
        }
        .collection-content {
            padding: 40px;
        }
        .newsletter-section {
            background: linear-gradient(135deg, #1a1a1a 0%, #4a4a4a 100%);
            color: white;
            padding: 80px 0;
            position: relative;
            overflow: hidden;
        }
        .newsletter-section::before {
            content: '';
            position: absolute;
            top: 0;
            left: 0;
            right: 0;
            bottom: 0;
            background: url('https://images.unsplash.com/photo-1607082348824-0a96f2a4b9da?ixlib=rb-1.2.1&auto=format&fit=crop&w=1950&q=80') center/cover;
            opacity: 0.1;
        }
        .btn-dark.rounded-circle {
            width: 40px;
            height: 40px;
            display: flex;
            align-items: center;
            justify-content: center;
            transition: all 0.3s ease;
        }
        .btn-dark.rounded-circle:hover {
            transform: scale(1.1);
            background: #000;
        }
    </style>
  </head>
  <body>
    <!-- Include header.ejs -->
    <%- include('../../partials/header.ejs') %>

    <!-- Hero Section -->
    <section class="hero-section">
        <div class="container">
            <div class="row justify-content-center">
                <div class="col-lg-8 text-center" data-aos="fade-up">
                    <h1 class="display-4 font-weight-bold mb-4">Welcome to Digital Marketplace</h1>
                    <p class="lead mb-5">Discover our latest collection of premium products and stay updated with the latest news</p>
                    <div class="d-flex justify-content-center gap-3">
                        <a href="/product" class="btn btn-light btn-lg px-5 py-3 rounded-pill font-weight-bold">Shop Now</a>
                        <a href="/news" class="btn btn-outline-light btn-lg px-5 py-3 rounded-pill font-weight-bold">Read News</a>
                    </div>
                </div>
            </div>
        </div>
    </section>

    <!-- Featured Products -->
    <section class="py-5">
        <div class="container">
            <h2 class="text-center mb-5" data-aos="fade-up">Featured Products</h2>
            <div class="row">
                <% products.forEach(product => { %>
                <div class="col-md-6 col-lg-4 mb-4" data-aos="fade-up">
                    <div class="product-card h-100 d-flex flex-column">
                        <div class="position-relative">
                            <img src="<%= product.thumbnail %>" alt="<%= product.title %>" class="product-image w-100">
                            <span class="category-badge"><%= product.category %></span>
                        </div>
                        <div class="p-4 d-flex flex-column flex-grow-1">
                            <h3 class="h5 font-weight-bold mb-2"><%= product.title %></h3>
                            <p class="text-muted mb-3 flex-grow-1"><%- product.description.replace(/<[^>]*>/g, '').slice(0, 100) %>...</p>
                            <div class="d-flex justify-content-between align-items-center mt-auto">
                                <span class="price-tag"><%= formatCurrency(product.price) %> VND</span>
                                <a href="/product/detail/<%= product.slugProduct %>" class="btn btn-dark rounded-circle">
                                    <i class="fas fa-arrow-right"></i>
                                </a>
                            </div>
                        </div>
                    </div>
                </div>
                <% }) %>
            </div>
        </div>
    </section>

    <!-- Features Section -->
    <section class="py-5 bg-light">
        <div class="container">
            <div class="row">
                <div class="col-md-6 col-lg-3 mb-4" data-aos="fade-up">
                    <div class="feature-card">
                        <div class="feature-icon">
                            <i class="fas fa-truck fa-2x text-dark"></i>
                        </div>
                        <h3 class="h5 font-weight-bold mb-2">Free Shipping</h3>
                        <p class="text-muted">On all orders over $100</p>
                    </div>
                </div>
                <div class="col-md-6 col-lg-3 mb-4" data-aos="fade-up" data-aos-delay="100">
                    <div class="feature-card">
                        <div class="feature-icon">
                            <i class="fas fa-undo fa-2x text-dark"></i>
                        </div>
                        <h3 class="h5 font-weight-bold mb-2">Easy Returns</h3>
                        <p class="text-muted">30 days return policy</p>
                    </div>
                </div>
                <div class="col-md-6 col-lg-3 mb-4" data-aos="fade-up" data-aos-delay="200">
                    <div class="feature-card">
                        <div class="feature-icon">
                            <i class="fas fa-lock fa-2x text-dark"></i>
                        </div>
                        <h3 class="h5 font-weight-bold mb-2">Secure Payment</h3>
                        <p class="text-muted">100% secure payment</p>
                    </div>
                </div>
                <div class="col-md-6 col-lg-3 mb-4" data-aos="fade-up" data-aos-delay="300">
                    <div class="feature-card">
                        <div class="feature-icon">
                            <i class="fas fa-headset fa-2x text-dark"></i>
                        </div>
                        <h3 class="h5 font-weight-bold mb-2">24/7 Support</h3>
                        <p class="text-muted">Dedicated support team</p>
                    </div>
                </div>
            </div>
        </div>
    </section>

    <!-- Collection Section -->
    <section class="collection-section">
        <div class="container">
            <div class="row align-items-center">
                <div class="col-md-6 mb-4 mb-md-0" data-aos="fade-right">
                    <img src="https://images.unsplash.com/photo-1607082348824-0a96f2a4b9da?ixlib=rb-1.2.1&auto=format&fit=crop&w=1950&q=80" 
                         alt="Collection" 
                         class="img-fluid rounded shadow">
                </div>
                <div class="col-md-6" data-aos="fade-left">
                    <div class="collection-content">
                        <h2 class="display-4 font-weight-bold mb-4">New Collection</h2>
                        <p class="lead mb-4">
                            Discover our latest collection of premium products. Each item is carefully selected to provide the best quality and style.
                        </p>
                        <a href="/category/new-and-featured" 
                           class="btn btn-dark btn-lg px-5 py-3 rounded-pill font-weight-bold">
                            Shop Collection
                        </a>
                    </div>
                </div>
            </div>
        </div>
    </section>

    <!-- Latest News -->
    <section class="py-5">
        <div class="container">
            <h2 class="text-center mb-5" data-aos="fade-up">Latest News</h2>
            <div class="row">
                <% news.forEach(item => { %>
                <div class="col-md-4 mb-4" data-aos="fade-up">
                    <div class="card border-0 shadow-sm">
                        <img src="<%= item.thumbnail %>" alt="<%= item.title %>" class="card-img-top" style="height: 200px; object-fit: cover;">
                        <div class="card-body">
                            <small class="text-muted d-block mb-2">
                                <%= item.createdAt.toLocaleString() %>
                            </small>
                            <h3 class="h5 font-weight-bold mb-2">
                                <a href="/news/<%= item.slugNews %>" class="text-dark">
                                    <%= item.title %>
                                </a>
                            </h3>
                            <p class="text-muted mb-3">
                                <%- item.description.replace(/<[^>]*>/g, '').slice(0, 150) %>...
                            </p>
                            <a href="/news/<%= item.slugNews %>" 
                               class="text-dark font-weight-bold">
                                Read More <i class="fas fa-arrow-right ml-2"></i>
                            </a>
                        </div>
                    </div>
                </div>
                <% }) %>
            </div>
        </div>
    </section>

    <!-- Newsletter Section -->
    <section class="newsletter-section">
        <div class="container">
            <div class="row justify-content-center">
                <div class="col-lg-8 text-center" data-aos="fade-up">
                    <h2 class="display-4 font-weight-bold mb-4">Subscribe to Our Newsletter</h2>
                    <p class="lead mb-5">Stay updated with our latest products and news</p>
                    <form class="row justify-content-center">
                        <div class="col-md-8 mb-3 mb-md-0">
                            <input type="email" 
                                   placeholder="Enter your email" 
                                   class="form-control form-control-lg rounded-pill">
                        </div>
                        <div class="col-md-4">
                            <button type="submit" 
                                    class="btn btn-light btn-lg w-100 rounded-pill font-weight-bold">
                                Subscribe
                            </button>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </section>

    <!-- Include footer.ejs -->
    <%- include('../../partials/footer.ejs') %>

    <!-- Scripts -->
    <script src="https://code.jquery.com/jquery-3.5.1.slim.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/@popperjs/core@2.9.2/dist/umd/popper.min.js"></script>
    <script src="https://stackpath.bootstrapcdn.com/bootstrap/4.5.2/js/bootstrap.min.js"></script>
    <script src="https://unpkg.com/aos@2.3.1/dist/aos.js"></script>
    <script>
        AOS.init({
            duration: 1000,
            once: true
        });
    </script>
  </body>
</html>
