<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Settings</title>
    <link rel="stylesheet" href="/client/css/style.css" />
    <link rel="stylesheet" href="/client/css/product.css" />
    <link rel="stylesheet" href="/client/css/setting-profile.css" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@4.3.1/dist/css/bootstrap.min.css" />
    <link href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/5.11.2/css/all.min.css" rel="stylesheet" />
    <style>
      .settings-container {
        max-width: 940px;
        margin: 0 auto;
        padding: 20px;
      }

      .settings-header {
        margin-bottom: 24px;
      }

      .settings-title {
        font-size: 24px;
        font-weight: 700;
        color: #1c1e21;
        margin-bottom: 8px;
      }

      .settings-subtitle {
        color: #65676b;
        font-size: 15px;
      }

      .settings-nav {
        background: #fff;
        border-radius: 8px;
        box-shadow: 0 1px 2px rgba(0,0,0,0.1);
        margin-bottom: 24px;
      }

      .settings-nav .nav-link {
        color: #65676b;
        font-weight: 600;
        padding: 16px;
        border-radius: 8px;
        transition: all 0.2s;
      }

      .settings-nav .nav-link:hover {
        background: #f2f2f2;
      }

      .settings-nav .nav-link.active {
        color: #1877f2;
        border-bottom: 3px solid #1877f2;
      }

      .settings-card {
        background: #fff;
        border-radius: 8px;
        box-shadow: 0 1px 2px rgba(0,0,0,0.1);
        margin-bottom: 24px;
      }

      .settings-card-header {
        padding: 16px;
        border-bottom: 1px solid #e4e6eb;
      }

      .settings-card-title {
        font-size: 17px;
        font-weight: 600;
        color: #1c1e21;
        margin: 0;
      }

      .settings-card-body {
        padding: 16px;
      }

      .profile-preview {
        display: flex;
        align-items: center;
        padding: 16px;
        border-bottom: 1px solid #e4e6eb;
      }

      .profile-avatar {
        width: 60px;
        height: 60px;
        border-radius: 50%;
        margin-right: 16px;
      }

      .profile-info {
        flex: 1;
      }

      .profile-name {
        font-size: 17px;
        font-weight: 600;
        color: #1c1e21;
        margin-bottom: 4px;
      }

      .profile-address {
        color: #65676b;
        font-size: 15px;
      }

      .form-group {
        margin-bottom: 20px;
      }

      .form-label {
        font-weight: 600;
        color: #1c1e21;
        margin-bottom: 8px;
      }

      .form-control {
        border: 1px solid #dddfe2;
        border-radius: 6px;
        padding: 12px;
        font-size: 15px;
        transition: all 0.2s;
      }

      .form-control:focus {
        border-color: #1877f2;
        box-shadow: 0 0 0 2px rgba(24, 119, 242, 0.2);
      }

      .btn-primary {
        background: #1877f2;
        border: none;
        border-radius: 6px;
        font-weight: 600;
        padding: 8px 16px;
        transition: all 0.2s;
      }

      .btn-primary:hover {
        background: #166fe5;
      }

      .password-requirements {
        background: #f0f2f5;
        border-radius: 6px;
        padding: 16px;
        margin-top: 16px;
      }

      .password-requirements-title {
        font-weight: 600;
        color: #1c1e21;
        margin-bottom: 8px;
      }

      .password-requirements-list {
        list-style: none;
        padding: 0;
        margin: 0;
      }

      .password-requirements-list li {
        color: #65676b;
        font-size: 13px;
        margin-bottom: 4px;
        display: flex;
        align-items: center;
      }

      .password-requirements-list li i {
        color: #1877f2;
        margin-right: 8px;
        font-size: 12px;
      }
    </style>
  </head>
  <body>
    <%- include('../../partials/header.ejs') %>
    
    <div class="settings-container">
      <div class="settings-header">
        <h1 class="settings-title">Settings</h1>
        <p class="settings-subtitle">Manage your account settings and preferences</p>
      </div>

      <div class="settings-nav">
        <ul class="nav nav-tabs" id="myTab" role="tablist">
          <li class="nav-item">
            <a class="nav-link active" id="profile-tab" data-toggle="tab" href="#profile" role="tab">
              <i class="fas fa-user mr-2"></i>Profile
            </a>
          </li>
          <li class="nav-item">
            <a class="nav-link" id="password-tab" data-toggle="tab" href="#password" role="tab">
              <i class="fas fa-lock mr-2"></i>Password
            </a>
          </li>
        </ul>
      </div>

      <div class="tab-content">
        <div class="tab-pane fade show active" id="profile" role="tabpanel">
          <div class="settings-card">
            <div class="profile-preview">
              <img src="<%=user.thumbnail%>" alt="" class="profile-avatar" />
              <div class="profile-info">
                <h3 class="profile-name"><%=user.fullName%></h3>
                <p class="profile-address"><%=user.address%></p>
              </div>
            </div>
            <form action="/user/setting-profile" method="POST">
              <div class="settings-card-body">
                <div class="form-group">
                  <label class="form-label" for="fullName">Full Name</label>
                  <input type="text" id="fullName" class="form-control" name="fullName" placeholder="<%=user.fullName%>" />
                </div>
                <div class="form-group">
                  <label class="form-label" for="email">Email</label>
                  <input type="email" class="form-control" id="email" name="email" placeholder="<%=user.email%>" />
                </div>
                <div class="form-group">
                  <label class="form-label" for="address">Address</label>
                  <input type="text" class="form-control" id="address" name="address" placeholder="<%=user.address%>" />
                </div>
                <button type="submit" class="btn btn-primary">
                  <i class="fas fa-save mr-2"></i>Save Changes
                </button>
              </div>
            </form>
          </div>
        </div>

        <div class="tab-pane fade" id="password" role="tabpanel">
          <div class="settings-card">
            <div class="settings-card-header">
              <h2 class="settings-card-title">Change Password</h2>
            </div>
            <form action="/user/setting-password" method="POST">
              <div class="settings-card-body">
                <div class="form-group">
                  <label class="form-label" for="password">Current Password</label>
                  <input type="password" class="form-control" id="password" name="password" />
                </div>
                <div class="form-group">
                  <label class="form-label" for="newPassword">New Password</label>
                  <input type="password" class="form-control" id="newPassword" name="newPassword" />
                </div>
                <div class="form-group">
                  <label class="form-label" for="newPasswordConfirm">Confirm New Password</label>
                  <input type="password" class="form-control" id="newPasswordConfirm" name="newPasswordConfirm" />
                </div>
                <div class="password-requirements">
                  <h3 class="password-requirements-title">Password Requirements</h3>
                  <ul class="password-requirements-list">
                    <li><i class="fas fa-check-circle"></i>Minimum 8 characters</li>
                    <li><i class="fas fa-check-circle"></i>At least one special character</li>
                    <li><i class="fas fa-check-circle"></i>At least one number</li>
                    <li><i class="fas fa-check-circle"></i>Can't be the same as a previous password</li>
                  </ul>
                </div>
                <button type="submit" class="btn btn-primary">
                  <i class="fas fa-key mr-2"></i>Change Password
                </button>
              </div>
            </form>
          </div>
        </div>
      </div>
    </div>

    <%- include('../../partials/footer.ejs') %>

    <script src="https://code.jquery.com/jquery-3.3.1.slim.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/popper.js@1.14.7/dist/umd/popper.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@4.3.1/dist/js/bootstrap.min.js"></script>
  </body>
</html>
